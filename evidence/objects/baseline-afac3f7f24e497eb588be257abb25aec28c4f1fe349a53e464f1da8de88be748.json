  "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Resident service application · Controlled fixture</title><style>*{box-sizing:border-box}body{margin:0;font:17px/1.55 system-ui;color:#162a32;background:#eef2f3}header,main,footer{max-width:1000px;margin:auto;padding:24px}header{border-bottom:1px solid #c6d2d6}h1{font-size:36px;line-height:1.2;margin:10px 0}h2{font-size:23px}main{display:grid;grid-template-columns:1fr 1fr;gap:40px}form{background:white;padding:28px;border:1px solid #c6d2d6;border-radius:4px}label,.field-title{display:block;margin-top:16px}input{width:100%;padding:12px;font:inherit;border:1px solid #667b85}button{margin-top:22px;background:#143c4c;color:white;border:0;padding:12px 22px;font:inherit;min-height:46px;cursor:pointer}.muted{color:#aaa;background:white}.sugamya-contrast{color:#344e5a!important;background:#fff!important}img{width:100%;max-height:170px;object-fit:contain;background:#d9e4e8}a{color:#154a62}:focus-visible{outline:3px solid #a74600;outline-offset:3px}footer{font-size:14px}@media(max-width:650px){main{grid-template-columns:1fr;gap:10px}h1{font-size:28px}}</style></head><body><header><strong>Resident services lab</strong><p>Owned test site · deliberately seeded accessibility barriers · not a government service</p></header><main><section><h1>Apply for a service visit</h1><p id=\"intro\">Request a visit to the resident service desk. No real personal details, please.</p><h2>Finding the desk</h2><img id=\"desk-map\" src=\"/map.svg\"><p id=\"map-context\">The diagram shows the route from the entrance to the service desk.</p><a href=\"#application\">Go to application</a></section><form id=\"application\"><h2>Your application</h2><p class=\"muted\" id=\"help\">All fields are required. Use test details only.</p><p class=\"field-title\" id=\"name-label\">Full name</p><input id=\"full-name\" name=\"fullName\" required autocomplete=\"name\"><label for=\"email\">Email address</label><input id=\"email\" name=\"email\" type=\"email\" required autocomplete=\"email\"><button id=\"submit\" type=\"submit\" data-action-label=\"Submit application\"><span aria-hidden=\"true\">→</span></button><p id=\"result\" role=\"status\" aria-live=\"polite\"></p></form></main><footer>Fixture maintained by The Screen Readers. No data is stored. The origin has no Sugamya runtime.</footer><script>document.querySelector('form').addEventListener('submit',async e=>{e.preventDefault();const f=e.target;if(!f.reportValidity())return;const r=await fetch('/apply',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(f))});document.querySelector('#result').textContent=r.ok?'Application received. Test reference SR-2026.':'Submission unavailable. Try later.';});if(location.pathname.endsWith('/dynamic')||document.documentElement.dataset.fixtureMode==='hydrate')setTimeout(()=>{document.querySelector('#full-name').removeAttribute('aria-label');document.querySelector('#full-name').removeAttribute('aria-labelledby');},250);</script></body></html>",
