# Do not invent or reuse example credentials. Run `npm run setup` to create strong private keys.
# Optional model key is never required for the deterministic/manual workflow.
GROQ_API_KEY=

# Optional text model provider (falls back to Groq when unset).
# SUGAMYA_MODEL_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# SUGAMYA_MODEL_API_KEY=
# SUGAMYA_MODEL_NAME=openai/gpt-oss-20b
# SUGAMYA_MODEL_PROVIDER=Groq

# Optional vision provider for provisional alt-text drafts.
# SUGAMYA_VISION_ENDPOINT=
# SUGAMYA_VISION_API_KEY=
# SUGAMYA_VISION_MODEL=xiaomi/mimo-v2.5

# External-URL mode persistence and the before-load proxy.
# SUGAMYA_EXTERNAL_STORE=var/external-sessions.json
# PROXY_PORT=4102
